{
  "name": "compliance-platform",
  "services": {
    "workflow": {
      "build": {
        "context": "../..",
        "dockerfile": "infra/local/Dockerfile"
      },
      "image": "compliance-platform-services:local",
      "environment": {
        "SERVICE_NAME": "workflow",
        "SERVICE_HOST": "0.0.0.0",
        "SERVICE_TOKEN_FILE": "/run/secrets/platform_token",
        "PLATFORM_DATA_DIR": "/state",
        "WORKFLOW_URL": "http://workflow:4318",
        "JOBS_URL": "http://jobs:4320",
        "DOCUMENTS_URL": "http://documents:4319",
        "POLICIES_URL": "http://policies:4321",
        "AUDIT_URL": "http://audit:4322",
        "AGENT_URL": "http://agent:4323",
        "WORKER_URL": "http://worker:4324",
        "WORKSPACE_FILE": "/state/workspace.json"
      },
      "secrets": [
        "platform_token"
      ],
      "restart": "unless-stopped",
      "healthcheck": {
        "test": [
          "CMD",
          "node",
          "services/healthcheck.mjs"
        ],
        "interval": "5s",
        "timeout": "3s",
        "retries": 10,
        "start_period": "5s"
      },
      "init": true,
      "volumes": [
        "workflow_data:/state"
      ]
    },
